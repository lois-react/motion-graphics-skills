{
  "name": "flinxy-video",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render src/index.ts FlinxyVideo out/flinxy.mp4 --codec=h264 --crf=18 && mkdir -p /out && cp out/flinxy.mp4 /out/flinxy.mp4",
    "still": "remotion still FlinxyVideo",
    "capture": "node scripts/capture.mjs",
    "draft": "remotion render src/index.ts FlinxyVideo out/flinxy-draft.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.535",
    "@remotion/fonts": "4.0.535",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.535"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "playwright": "^1.64.0",
    "typescript": "^5.9.3"
  }
}
